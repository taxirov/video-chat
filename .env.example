# Vercel loyihangizga Storage -> Marketplace -> Upstash (Redis) qo'shsangiz,
# quyidagi o'zgaruvchilar avtomatik qo'shiladi.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Push-xabarnomalar uchun (ilova yopiq/fon rejimida bo'lganda ham
# qo'ng'iroq haqida xabar berish). README.md'da qanday olishni o'qing —
# yoki tayyor juftlikni shu yerga qo'ying:
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sizning-emailingiz@example.com

# TURN server (turli tarmoqlar orasidagi — masalan Wi-Fi va mobil internet —
# qo'ng'iroqlar ishlashi uchun SHART). README.md'dagi "Tarmoq ulanishi"
# bo'limini o'qing.
TURN_USERNAME=
TURN_CREDENTIAL=
